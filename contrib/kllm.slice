[Unit]
Description=Local LLM inference -- capped so the model's page cache cannot wedge the box
Documentation=man:systemd.resource-control(5)

# Same lesson as heavy.slice, different shape. kllm serve mmaps a 12 GiB model
# and demand-pages its experts, so nearly all of its footprint is reclaimable
# file cache rather than anonymous memory -- the cap acts as a cache ceiling,
# not an allocation limit, and the kernel drops clean pages instead of OOMing.
#
# It is set high on purpose. Measured expert locality on a routed model of this
# shape: 61% hit at 1.9 GiB of cache, 85% at 4.8, 92% at 7.2. Below ~5 GiB the
# hit rate falls off a cliff and every miss is an NVMe read. heavy.slice's 7 G
# would sit right on the knee, so inference gets its own slice above it --
# while still leaving the recorders (about 5 GiB) room to avoid the global OOM
# killer that cost curvetape 62 of 180 minutes on 11/14.
#
# Sized against what else lives on this 15.8 GiB box, not against what
# inference would like: about 5 GiB of memecoin recorders, a bit over 1 GiB of
# long-running editor sessions, and the OS. 10G/12G was set for a 128k context
# and over-committed the machine -- `available` fell to 225 MiB and the page
# cache collapsed to 279 MiB, which starves the expert cache this is supposed
# to protect and risks the global OOM killer that cost curvetape 62 of 180
# minutes on 11/14.
#
# At a 128k context roughly 2.9 GiB of the allowance is unreclaimable (2.5 GiB
# KV plus scratch), so this leaves about 4.5-6 GiB of expert cache -- around
# the measured 85%-hit point of 4.8 GiB. Lower the context in serve.env if you
# would rather spend that 2.5 GiB on cache than on context.
[Slice]
MemoryHigh=7500M
MemoryMax=9G
# Never swap: the KV cache is hot anonymous memory and the weights are a
# file-backed mapping that should be re-read from NVMe, not written to swap.
MemorySwapMax=256M
