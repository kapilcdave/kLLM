# Which local model `kllm-serve` loads, and how. Edit, then:
#   systemctl --user restart kllm-serve
#
# Switching models costs a cold page cache either way, so expect the first
# couple of answers after a restart to be slow (see WARM-UP in claude-kllm).

# Default: the uncensored Qwen3.5-35B. Hybrid attention/SSM, so its KV cache
# is 20 KiB/token against the 30B's 96 -- which is what makes a 32k context
# affordable here at all.
KLLM_MODEL=/home/kapil/ai/models/Qwen3.5-35B-abliterated/Huihui-Qwen3.5-35B-A3B-Claude-4.6-Opus-abliterated.i1-Q2_K.gguf
KLLM_NAME=qwen3.5-35b-uncensored

# The alternative, measured on the same box and day: ~18% faster to decode
# (10.2 vs 8.4 tok/s) but 96 KiB/token of KV, so ~16k context is the ceiling.
#KLLM_MODEL=/home/kapil/ai/models/Qwen3-30B-abliterated/Huihui-Qwen3-30B-A3B-Instruct-2507-abliterated.Q4_K_M.gguf
#KLLM_NAME=qwen3-30b-uncensored

# 128k. The model is trained to 262144, and because only 10 of its 40 blocks
# keep a KV cache this costs 2.50 GiB -- the 30B would want 12 GiB for the
# same and simply cannot do it.
#
# ⚠ Memory is NOT the binding constraint at this size, prefill is. Reading
# 128k tokens at 12-18 tok/s is about two and a half hours, so you never want
# to fill this context in one request. It works because the conversation grows
# into it a turn at a time and the prefix cache means each turn only reads
# what is new. The thing to avoid is anything that invalidates that prefix:
# on a recurrent model a rewind replays from zero, so a miss at 100k tokens
# costs hours, not seconds. Watch `prompt N reused + M read` in the log.
KLLM_CONTEXT=131072
KLLM_PORT=8787

# Prefill batch. Wider is faster for a routed model (measured 16/64/256 at
# 10-14 / 13-15 / 17-18 tok/s) but costs logits scratch.
KLLM_BATCH=256

# Shared secret between the server and `claude-kllm`. The server binds
# 127.0.0.1 only, so this is hygiene rather than the security boundary.
KLLM_TOKEN=local-kllm-only

# Anything else to pass through, e.g. --think to let a reasoning model reason
# (off by default: a client sends a max_tokens budget and expects an answer
# inside it, and this model is an Opus distill that will happily spend it all
# deliberating).
KLLM_EXTRA=
